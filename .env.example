# ---------------------------------------------------------------------------
# NFR-01: no secrets are committed. Copy this file to `.env` and fill in the
# value. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env        (PowerShell:  Copy-Item .env.example .env)
#
# Get a key at https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------

# The ONLY provider credential this project uses. Google Gemini.
# Either name works -- GEMINI_API_KEY is what Google AI Studio calls it.
GOOGLE_API_KEY=your-google-gemini-api-key-here
# GEMINI_API_KEY=your-google-gemini-api-key-here

# --- Optional overrides ------------------------------------------------------
# Every one of these has a default in config/config.yaml. Set them here only to
# override without editing the committed config (NFR-04).

# Primary generation model.
# CATALOG_RAG_LLM__PRIMARY_MODEL=gemini-2.5-flash

# Challenger model used by the two-model comparison (AC-10).
# CATALOG_RAG_LLM__CHALLENGER_MODEL=gemini-2.5-pro

# Judge model used by the RAGAS harness (AC-09).
# CATALOG_RAG_EVAL__JUDGE_MODEL=gemini-2.5-flash

# Set to 1 to force Sentence-Transformers to run fully offline once models are
# cached locally (useful on a locked-down corporate laptop).
# HF_HUB_OFFLINE=0
